@echo off
echo Starting i-see...

echo Freeing up port 3000 to prevent conflicts...
call npx -y kill-port 3000 > NUL 2>&1

echo Starting Next.js...
start "i-see Next.js" cmd /c "npm run dev"

echo Waiting for Next.js to initialize...
ping 127.0.0.1 -n 6 > nul

echo Opening i-see...
start http://localhost:3000
